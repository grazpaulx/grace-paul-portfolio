# Copy this file to .env.local for local development.
# On Vercel, set these under Project Settings -> Environment Variables instead.

# Admin password for the login bar and calendar editing.
# Replace this with a real password before deploying.
ADMIN_PASSWORD=gracepaul-pmvikas-2026

# These two are created automatically when you attach a Vercel KV database
# to this project (Storage tab -> Create Database -> KV). You do not need
# to set them by hand on Vercel. For local development against a real KV
# instance, copy the values Vercel shows you into .env.local.
KV_REST_API_URL=
KV_REST_API_TOKEN=
